.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw source data is large (6 MB+) and re-fetchable via scripts/fetch_data.sh.
# PROVENANCE.tsv is tracked so a past run's exact inputs stay identifiable.
data/raw/*
!data/raw/PROVENANCE.tsv
!data/raw/SNAPSHOT.json
# The official Senate vote records behind the Pillar 1 bindings: senate.gov now refuses automated requests.
!data/raw/explanations/
data/raw/explanations/*
!data/raw/explanations/senate/
data/processed/*
!data/processed/.gitkeep

# editable-install build artifact
*.egg-info/

# never commit credentials
*.key
.env
secrets*

# Built by python -m civicalign.build_site from committed inputs; published from the workspace.
demo/civicalign.html
demo/data/
demo/photos/
# Arranged by python -m civicalign.publish_site from demo/ after every gate passes.
_site/
